{
  "name": "foodbridge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev -w client",
    "seed": "node server/scripts/seed.js",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w client",
    "lint": "eslint .",
    "build": "npm run build -w client",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.9.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "puppeteer-core": "^25.16.0",
    "supertest": "^7.0.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.5"
  }
}
